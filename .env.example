# Banco de Dados
# DATABASE_URL=sqlite:///instance/database.db
# ou
# DATABASE_URL=postgresql+psycopg://postgres:senha@localhost:5432/pautaon
# (Use PostgreSQL se preferir persistência de produção e escalabilidade.)

# Segurança Base
SECRET_KEY=troque-esta-chave-em-producao
FLASK_ENV=development
FLASK_DEBUG=true

# Bootstrap administrativo
ADMIN_EMAIL=admin@email.com
ADMIN_NAME=Administrador
ADMIN_DEFAULT_PASSWORD=senha@123
ADMIN_FORCE_PASSWORD_CHANGE=true

# LDAP / AD
LDAP_SERVER_URI=ldaps://servidor.domínio:636
LDAP_USE_SSL=true
LDAP_CONNECT_TIMEOUT=10
LDAP_DOMAIN=domínio
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT_FILE=localDoCertificado/pautaon/instance/certs/pgrael-srv001.cer

# -----------------------------------------------------------------------------
# Google OAuth2 — Login de usuários via conta Google
# -----------------------------------------------------------------------------
# Crie um projeto no Google Cloud Console → APIs e Serviços → Credenciais →
# "Criar credenciais" → "ID do cliente OAuth" → tipo "Aplicativo Web".
# Adicione o URI abaixo em "URIs de redirecionamento autorizados".
#
# GOOGLE_OAUTH_CLIENT_ID e GOOGLE_OAUTH_CLIENT_SECRET ficam na aba
# "Credenciais" → clique no lápis do cliente criado.
# Enquanto não preenchidos, o botão "Entrar com Google" não aparece na tela de login.

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Deve ser idêntico ao URI registrado no Google Cloud Console.
# Exemplo produção: https://seudominio.com.br/auth/google/callback
# Exemplo dev:      http://localhost:5000/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Necessário em desenvolvimento para permitir http:// no redirect URI.
# A biblioteca google-auth-oauthlib exige HTTPS por padrão.
# O código define isso automaticamente quando FLASK_DEBUG=true.
# NUNCA defina como 1 em produção.
OAUTHLIB_INSECURE_TRANSPORT=1

# -----------------------------------------------------------------------------
# Google Calendar (Serviço Social — app/services/calendar_service.py)
# -----------------------------------------------------------------------------
# ID do calendário onde os eventos são criados (ex.: xxxx@group.calendar.google.com).
# O calendário deve estar compartilhado com o e-mail da conta de serviço (client_email do JSON).
GOOGLE_CALENDAR_ID=

# Caminho absoluto para o JSON da conta de serviço (fora do repositório).
# Exemplo Windows: C:/inetpub/secrets/pautaon-google-calendar.json
# Exemplo Linux:   /etc/pautaon/secrets/pautaon-google-calendar.json
GOOGLE_SERVICE_ACCOUNT_FILE=caminhoDojason\pautaon-google-calendar.json

# Opcional: impersonação (domain-wide delegation no Google Workspace).
# Só preencha se a TI configurar delegação para esta service account.
# Exemplo: coordenacao@escola.edu.br
GOOGLE_CALENDAR_DELEGATED_USER=

# Escopo OAuth fixo no código (config.py) — não há variável de ambiente:
#   https://www.googleapis.com/auth/calendar

# -----------------------------------------------------------------------------
# Google Chat — Notificador de pauta (scripts/notificador.py)
# -----------------------------------------------------------------------------
# JSON da conta de serviço com permissão para Chat API.
# Se vazio, o notificador usa GOOGLE_SERVICE_ACCOUNT_FILE (mesmo arquivo do Calendar),
# desde que a conta no Google Cloud tenha escopos de Chat habilitados.
GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=caminhoDojason\pautaon-google-chat.json

# Escopos separados por vírgula (padrão usado pelo script).
GOOGLE_CHAT_SCOPES=https://www.googleapis.com/auth/chat.messages.create,https://www.googleapis.com/auth/chat.spaces

# Dias após a data da aula para enviar lembrete (padrão 7).
NOTIFICADOR_DIAS_ATRASO=7

# true = apenas loga o que seria enviado, sem chamar a API do Chat.
NOTIFICADOR_DRY_RUN=true

# DEBUG, INFO, WARNING ou ERROR
NOTIFICADOR_LOG_LEVEL=INFO
